# Copy to .env and fill in values:
#   cp .env.example .env
#
# Docker Compose reads ONLY this file (server/.env) when run from server/.
# Do NOT edit outreach/.env or research/.env for Docker — those are for local non-Docker runs.

# Django / shared
SECRET_KEY=your-secret-key-here
DEBUG=True
CELERY_BROKER_URL=redis://localhost:6379/0

# Postgres (docker-compose)
POSTGRES_USER=salesdev
POSTGRES_PASSWORD=salesdev
POSTGRES_DB=salesdev

# Gemini (research + outreach)
GOOGLE_API_KEY=your-google-api-key

# Gmail SMTP app password (outreach sends)
GMAIL_SENDER=your-email@gmail.com
GMAIL_PASSWORD=your-16-char-app-password
GMAIL_SENDER_NAME=Your Name
COMPANY_NAME=Your Company
COMPANY_DESCRIPTION=One-line description of what your product does (shown in email footer)

# Google Calendar (meeting scheduling agent)
# Same OAuth client as Gmail/n8n; scope must include https://www.googleapis.com/auth/calendar.events
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
DEFAULT_TIMEZONE=UTC
DEFAULT_MEETING_DURATION_MINUTES=30

# LinkedIn scraper credentials (leads service)
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

# Internal service auth
LEADS_SERVICE_INTERNAL_SECRET=dev-internal-secret
