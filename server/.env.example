# Copy to .env and fill in values:
#   cp .env.example .env
#
# Docker Compose reads ONLY this file (server/.env) when run from server/.
# Do NOT edit outreach/.env or research/.env for Docker — those are for local non-Docker runs.

# Django / shared
SECRET_KEY=your-secret-key-here
DEBUG=True
CELERY_BROKER_URL=redis://localhost:6379/0

# Postgres (docker-compose)
POSTGRES_USER=salesdev
POSTGRES_PASSWORD=salesdev
POSTGRES_DB=salesdev

# Gemini (research + outreach)
GOOGLE_API_KEY=your-google-api-key

# Gmail display name for outbound emails (optional; uses connected Google account via API)
GMAIL_SENDER_NAME=Your Name
COMPANY_NAME=Your Company
COMPANY_DESCRIPTION=One-line description of what your product does (shown in email footer)

# Google OAuth (per-user connect in Settings; tokens stored in DB)
# Enable Gmail API + Google Calendar API; add redirect URI in Google Cloud Console.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/settings/google-callback

# n8n API (Gmail connect provisions per-user credential + workflow automatically)
N8N_API_URL=http://n8n:5678
N8N_API_KEY=

# LinkedIn scraper credentials (leads service)
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

# Internal service auth
LEADS_SERVICE_INTERNAL_SECRET=dev-internal-secret
